    {
      "parameters": {
        "jsCode": "// Previous node-ல  items\nconst items = $input.all().map(i => i.json);\n\n// Unique jobs filter பண்ணுறோம் (Apply Link-அ base வச்சு)\nconst uniqueJobs = [];\nconst seenLinks = new Set();\n\nfor (const job of items) {\n  const link = job['Apply Link'] || job.Apply_Link || job.links;\n  if (link && !seenLinks.has(link)) {\n    seenLinks.add(link);\n    uniqueJobs.push({ json: job });\n  }\n}\n\nreturn uniqueJobs;"
      },
